<Window x:Class="Nova.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Nova"
        mc:Ignorable="d"
        Title="MainWindow"
        Height="60"
        Width="700"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="Transparent"
        AllowsTransparency="True"
        SizeToContent="Manual"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Grid Background="Transparent">

        <Border
            Background="White"
            CornerRadius="12"
            Padding="14"
            BorderThickness="2"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch">

            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#4F8CFF" Offset="0" />
                    <GradientStop Color="#A855F7" Offset="1" />
                </LinearGradientBrush>
            </Border.BorderBrush>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBox
                    x:Name="SearchBox"
                    FontSize="18"
                    Background="Transparent"
                    BorderThickness="0"
                    Foreground="Black"
                    TextChanged="SearchBox_TextChanged"
                    Grid.Row="0"/>

                <TextBlock
                    x:Name="PlaceholderText"
                    Text="Type to search applications"
                    FontSize="18"
                    Foreground="Gray"
                    IsHitTestVisible="False"
                    Margin="2,0,0,0"
                    VerticalAlignment="Center"/>

                <ListBox
                    x:Name="ResultsList"
                    Grid.Row="1"
                    BorderThickness="0"
                    Background="White"
                    Foreground="Black"
                    FontSize="16"
                    Margin="0,10,0,0"
                    SelectionMode="Single"
                    MouseDoubleClick="ResultsList_MouseDoubleClick" >

                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="6"/>
                            <Setter Property="Height" Value="40"/>

                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#E8E8FF"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>

                </ListBox>

            </Grid>
        </Border>

    </Grid>
</Window>